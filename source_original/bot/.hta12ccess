Options -Indexes

# Запретить доступ ко всем PHP кроме telegram.php
<FilesMatch "\.php$">
  Require all denied
</FilesMatch>

<Files "telegram.php">
  Require all granted
</Files>

# Запретить доступ к данным и конфигам
<FilesMatch "^(config\.php|config\.sample\.php|.*\.json|.*\.log|.*\.txt)$">
  Require all denied
</FilesMatch>
ErrorDocument 404 /404.php